# Port the API server listens on
PORT=4000

# Secret used to sign JWTs — set a long random value in any real deployment
JWT_SECRET=dev-only-secret-change-me

# Supabase PostgreSQL session-pooler URI. Replace all placeholders with the
# connection string from Supabase Dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Seeded admin account (created on first boot if missing)
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

